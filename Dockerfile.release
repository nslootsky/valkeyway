# The release image: packages a jar built beforehand (./mvnw package), so it can be built for
# several platforms without compiling under emulation. For a build from source, use Dockerfile.

# A Java runtime with only the modules the proxy uses (about half the size of the full JRE), found
# by jdeps from the jar itself, so it follows the dependencies. jdeps can't see two modules the
# JDK only looks up at runtime: jdk.net (extended socket options) and jdk.management.jfr (JFR
# over JMX).
FROM docker.io/eclipse-temurin:25-jdk AS runtime
COPY target/valkeyway-*.jar /tmp/app.jar
RUN mkdir /tmp/app && cd /tmp/app && jar xf /tmp/app.jar \
    && modules="$(jdeps --ignore-missing-deps --print-module-deps --multi-release 25 -q \
        --class-path 'BOOT-INF/lib/*' BOOT-INF/classes BOOT-INF/lib/*.jar)" \
    && echo "Java modules: $modules" \
    && jlink --add-modules "$modules,jdk.net,jdk.management.jfr" \
        --strip-debug --no-man-pages --no-header-files --compress=zip-6 --generate-cds-archive \
        --output /runtime

# glibc-based on purpose: Glide's native library exists for linux x86_64 and aarch64 (glibc), but
# for musl (Alpine) only on x86_64.
FROM docker.io/library/debian:13-slim

# jemalloc, linked to one path for every architecture (it installs under /usr/lib/<arch>-linux-gnu),
# and the system CA certificates, for backend TLS (proxy.backend.tls without a ca-file).
RUN apt-get update \
    && apt-get install -y --no-install-recommends libjemalloc2 ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s "$(ls /usr/lib/*-linux-gnu/libjemalloc.so.2)" /usr/local/lib/libjemalloc.so.2
ENV JAVA_HOME=/opt/java/openjdk PATH=/opt/java/openjdk/bin:$PATH LANG=C.UTF-8
COPY --from=runtime /runtime $JAVA_HOME
RUN useradd --system --no-create-home --shell /usr/sbin/nologin valkeyway
WORKDIR /app
COPY target/valkeyway-*.jar app.jar
USER valkeyway

# Memory, measured under heavy load (docs/OPERATIONS.md#sizing): sized for a 2 GB container.
# - G1, 70% heap: G1's frequent young collections let Glide free the native memory behind large
#   responses (>16 KB) promptly. Avoid ZGC: with it that native memory ran to several GB.
# - jemalloc, which returns memory after load spikes.
# - Compact object headers (Java 25); exit on heap exhaustion so the container restarts.
# Override any of these variables to change them.
ENV LD_PRELOAD=/usr/local/lib/libjemalloc.so.2 \
    MALLOC_CONF=metadata_thp:auto,background_thread:true \
    JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=70 -XX:+UseCompactObjectHeaders -XX:+ExitOnOutOfMemoryError"

EXPOSE 6379 6380

# No curl or wget in the image: ask the health endpoint over bash's /dev/tcp.
HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=3 \
    CMD ["bash", "-c", "exec 3<>/dev/tcp/127.0.0.1/6380 && printf 'GET /actuator/health HTTP/1.0\\r\\nHost: localhost\\r\\n\\r\\n' >&3 && grep -q '\"status\":\"UP\"' <&3"]

ENTRYPOINT ["java", "-jar", "app.jar"]
